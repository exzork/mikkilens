# Build output
/dist/
/apps/desktop/out/
/node_modules/
/apps/desktop/node_modules/
*.tsbuildinfo

# Hers, not the repository's.
#
# config.toml holds the OBS password, so it never goes in; config.example.toml
# is the template. data/ holds her logs, her YouTube token, her API keys and
# the downloaded speech models.
#
# The command files are NOT ignored: the phrases are part of the product, the
# tests load them, and a fresh clone needs them to have any commands at all.
# Editing them will show up as a diff, which is the right trade.
/config.toml
/data/

# Credentials, which never belong in a public repository.
#
# .npmrc carries an npm auth token. The OAuth client is read from
# data/client_secret.json at runtime rather than built into the binary: a
# secret in a source tree is scraped within hours, and Google revokes the
# client rather than the copy that leaked -- which would break the sign-in for
# everyone at once, including her, mid-stream.
/.npmrc
/packages/controllers/youtube/embedded_client_secret.json

# Editor and OS noise
.DS_Store
Thumbs.db
*.swp
