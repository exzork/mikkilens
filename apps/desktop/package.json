{
  "name": "@mikkilens/desktop",
  "version": "0.2.0",
  "private": true,
  "description": "MikkiLens settings and status, as a desktop app",
  "main": "out/main/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "start": "npm run build && electron .",
    "dev": "npm run build && electron . --dev",
    "package": "npm run build && electron-builder --win --dir"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.2"
  },
  "build": {
    "appId": "id.mikkilens.desktop",
    "productName": "MikkiLens",
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../dist/mikkilensd.exe",
        "to": "mikkilensd.exe"
      }
    ],
    "win": {
      "target": "nsis"
    }
  }
}
